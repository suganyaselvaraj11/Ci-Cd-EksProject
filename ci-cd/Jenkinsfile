pipeline {
    agent any

    tools {
        maven 'maven3'
        jdk 'JDK21'
    }

    environment {
        IMAGE_NAME = "sakthisuganya/ci-cd-eksproject"
        IMAGE_TAG  = "latest"

        // IMPORTANT: ensures kubectl uses correct cluster config
        KUBECONFIG = "/var/jenkins_home/.kube/config"
    }

    stages {

        /* ---------------- CHECKOUT ---------------- */
        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/suganyaselvaraj11/Ci-Cd-EksProject.git'
            }
        }

        /* ---------------- CLEAN ---------------- */
        stage('Clean Workspace') {
            steps {
                sh 'rm -rf target'
            }
        }

        /* ---------------- BUILD ---------------- */
        stage('Build Maven Project') {
            steps {
                sh 'mvn clean package -DskipTests -B'
            }
        }

        /* ---------------- VERIFY ARTIFACT ---------------- */
        stage('Verify Artifact') {
            steps {
                sh '''
                    echo "Workspace:"
                    pwd
                    ls -l

                    echo "Target folder:"
                    ls -l target/
                '''
            }
        }

        /* ---------------- SONARQUBE ---------------- */
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh 'mvn sonar:sonar -DskipTests'
                }
            }
        }

        /* ---------------- QUALITY GATE ---------------- */
        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        /* ---------------- DOCKER BUILD ---------------- */
        stage('Build Docker Image') {
            steps {
                sh """
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} \
                    -f docker/Dockerfile .
                """
            }
        }

        /* ---------------- TRIVY SCAN ---------------- */
        stage('Trivy Security Scan') {
            steps {
                sh """
                    trivy image \
                    --scanners vuln \
                    --timeout 10m \
                    --exit-code 0 \
                    --severity HIGH,CRITICAL \
                    --ignore-unfixed \
                    ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        /* ---------------- DOCKER PUSH ---------------- */
        stage('Docker Login & Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh '''
                        echo "$PASS" | docker login -u "$USER" --password-stdin
                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    '''
                }
            }
        }

        /* ---------------- KUBERNETES CHECK ---------------- */
        stage('Kubernetes Cluster Check') {
            steps {
                sh '''
                    export KUBECONFIG=/var/jenkins_home/.kube/config

                    echo "Checking cluster..."
                    kubectl cluster-info
                    kubectl get nodes
                '''
            }
        }

        /* ---------------- DEPLOY ---------------- */
        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    export KUBECONFIG=/var/jenkins_home/.kube/config

                    echo "Deploying application..."
                    kubectl apply -f kubernetes/

                    echo "Pods:"
                    kubectl get pods

                    echo "Services:"
                    kubectl get svc

                    kubectl rollout status deployment --all
                '''
            }
        }
    }

    post {
        success {
            echo "✅ CI/CD Pipeline SUCCESSFUL!"
        }

        failure {
            echo "❌ Pipeline FAILED. Check logs carefully."
        }
    }
}