pipeline {
    agent any

    tools {
        maven 'maven3'
        jdk 'JDK21'
    }

    environment {
        IMAGE_NAME = "sakthisuganya/ci-cd-eksproject"
        IMAGE_TAG  = "${BUILD_NUMBER}"   // 🔥 dynamic version
        KUBECONFIG = "/var/jenkins_home/.kube/config"
    }

    stages {

        /* ---------------- CHECKOUT ---------------- */
        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/suganyaselvaraj11/Ci-Cd-EksProject.git'
            }
        }

        /* ---------------- BUILD ---------------- */
        stage('Build Maven Project') {
            steps {
                sh 'mvn clean package -DskipTests -B'
            }
        }

        /* ---------------- DOCKER BUILD ---------------- */
        stage('Build Docker Image') {
            steps {
                sh """
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -f docker/Dockerfile .
                    docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
                """
            }
        }

        /* ---------------- TRIVY SCAN ---------------- */
        stage('Trivy Scan') {
            steps {
                sh """
                    docker run --rm \
                    -v /var/run/docker.sock:/var/run/docker.sock \
                    aquasec/trivy image \
                    --severity HIGH,CRITICAL \
                    --exit-code 1 \
                    ${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        /* ---------------- PUSH ---------------- */
        stage('Push Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh '''
                        echo "$PASS" | docker login -u "$USER" --password-stdin
                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                        docker push ${IMAGE_NAME}:latest
                    '''
                }
            }
        }

        /* ---------------- CONFIGURE EKS ---------------- */
        stage('Configure EKS') {
            steps {
                sh '''
                    aws eks update-kubeconfig --region ap-south-1 --name devops-eks
                    kubectl get nodes
                '''
            }
        }

        /* ---------------- UPDATE IMAGE ---------------- */
        stage('Update K8s Image') {
            steps {
                sh '''
                    sed -i "s|image: .*|image: sakthisuganya/ci-cd-eksproject:${BUILD_NUMBER}|g" k8s/app/deployment.yaml
                '''
            }
        }

        /* ---------------- DEPLOY ---------------- */
        stage('Deploy to EKS') {
            steps {
                sh '''
                    kubectl apply -f k8s/

                    kubectl rollout restart deployment app -n devops
                    kubectl rollout status deployment app -n devops
                '''
            }
        }
    }

    post {
        success {
            echo "✅ FULL CI/CD SUCCESS (Build → Scan → Push → Deploy)"
        }
        failure {
            echo "❌ Pipeline FAILED"
        }
    }
}