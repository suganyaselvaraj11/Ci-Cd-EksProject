pipeline {
    agent any

    tools {
        maven 'maven3'
        jdk 'JDK21'
    }

    environment {
        IMAGE_NAME = "sakthisuganya/ci-cd-eksproject"
        IMAGE_TAG  = "latest"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/suganyaselvaraj11/Ci-Cd-EksProject.git'
            }
        }

        stage('Clean Workspace') {
            steps {
                sh 'rm -rf target'
            }
        }

        stage('Build Maven Project') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Verify Artifact') {
            steps {
                sh '''
                    echo "Workspace:"
                    pwd
                    ls -l

                    echo "Target folder:"
                    ls -l target/
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        /* ---------------- TRIVY SCAN (FIXED) ---------------- */
        stage('Trivy Security Scan') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    sh """
                        echo "Scanning Docker image with Trivy..."
                        trivy image \
                          --exit-code 0 \
                          --severity HIGH,CRITICAL \
                          --ignore-unfixed \
                          ${IMAGE_NAME}:${IMAGE_TAG}
                    """
                }
            }
        }

        /* ---------------- DOCKER BUILD ---------------- */
        stage('Build Docker Image') {
            steps {
                sh '''
                    echo "Starting Docker build..."
                    ls -l docker/
                    ls -l target/

                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -f docker/Dockerfile .
                '''
            }
        }

        /* ---------------- DOCKER PUSH ---------------- */
        stage('Docker Login & Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh '''
                        echo "$PASS" | docker login -u "$USER" --password-stdin
                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    '''
                }
            }
        }

        /* ---------------- KUBERNETES DEPLOY (NEW) ---------------- */
        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    echo "Deploying to Minikube Kubernetes..."

                    kubectl apply -f kubernetes/

                    echo "Pods:"
                    kubectl get pods

                    echo "Services:"
                    kubectl get svc
                '''
            }
        }
    }

    post {
        success {
            echo '✅ CI/CD + Trivy + Kubernetes deployment SUCCESSFUL!'
        }

        failure {
            echo '❌ Pipeline failed. Check logs carefully.'
        }
    }
}